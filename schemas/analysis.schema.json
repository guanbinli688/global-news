{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-bound AI analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_zh", "summary_zh", "section_id", "topic_ids", "region_ids", "material_update", "claims", "analysis", "unknowns"],
  "properties": {
    "title_zh": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary_zh": {"type": "string", "minLength": 1, "maxLength": 500},
    "section_id": {"enum": ["headlines", "under_currents", "science_technology", "business", "society_world", "controversies", "corrections", "next24h"]},
    "topic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["politics", "war", "economy", "business", "science", "society", "culture", "climate", "health", "education", "energy", "food", "disasters", "sport", "law"]}},
    "region_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["north_america", "europe_russia", "east_asia", "southeast_asia", "south_asia", "central_asia_caucasus", "mena", "sub_saharan_africa", "latin_america_caribbean", "oceania_pacific", "global"]}},
    "material_update": {"type": "string", "minLength": 1, "maxLength": 300},
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text_zh", "kind", "source_ids", "attribution", "verification_note"],
        "properties": {
          "text_zh": {"type": "string", "minLength": 1, "maxLength": 300},
          "kind": {"enum": ["fact", "attributed_claim", "analysis", "scheduled_event"]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "attribution": {"type": ["string", "null"]},
          "verification_note": {"type": "string", "maxLength": 300}
        }
      }
    },
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["why_it_matters", "mechanism", "affected_groups", "counter_evidence", "watch_next"],
      "properties": {
        "why_it_matters": {"type": ["string", "null"], "maxLength": 600},
        "mechanism": {"type": ["string", "null"], "maxLength": 600},
        "affected_groups": {"type": ["string", "null"], "maxLength": 400},
        "counter_evidence": {"type": ["string", "null"], "maxLength": 500},
        "watch_next": {"type": ["string", "null"], "maxLength": 400}
      }
    },
    "unknowns": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 240}}
  }
}
